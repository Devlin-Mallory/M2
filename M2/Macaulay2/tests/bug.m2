gbTrace = 3

-----------------------------------------------------------------------------
-- Position-over-term computations without changing the ring.
--
-- With the default term-over-position order the constant entries of gens M
-- (in the degree 3 rows) are never chosen as lead terms, and the gb of
-- gens M | relations M blows up (~400k terms by degree 6, hours in total).
-- With position-over-term the constants become pivots: everything below
-- takes well under a second.
--
-- A free module may carry its own (Schreyer) order, used by the engine instead
-- of the ring's: m*e_i vs n*e_j compares m*b_i vs n*b_j, ties broken by i.
-- With b_i = x^(L*i) and L large, this is {Position => Up, <ring order>}.
-- Assumes a degree-first ring order (e.g. GRevLex) with weights proportional
-- to the first degree, and that the last variable is not nilpotent.
-- Caveats: M' === M (=== ignores Schreyer orders), and M' == M is slow,
-- since it computes a gb in the original order.

debug Core -- for raw, rawMatrixRemake2

-- the free module F, with the same ring and degrees, ordered position-over-term
potFreeModule = method()
potFreeModule Module := Module => F -> F.cache.potFreeModule ??= (
    if not isFreeModule F then error "potFreeModule: expected a free module";
    R := ring F;
    if numgens F == 0 then return F;
    x := last gens R;
    dx := first degree x;
    if dx <= 0 then error "potFreeModule: expected the last variable to have positive degree";
    d := apply(degrees F, first);
    L := ceiling((max d - min d + 1) / dx);
    b := apply(numgens F, i -> x^(L * i));
    if any(b, zero) then error "potFreeModule: the last variable is nilpotent";
    source schreyerOrder map(R^1, F, {b}))

-- f with its target replaced by F' (same degrees, different order).
-- map(F', source f, f) does not work: F' === target f, so it returns f unchanged.
retarget = (F', f) -> (
    if degrees F' != degrees target f then error "retarget: degrees do not match";
    map(F', source f,
	rawMatrixRemake2(raw F', raw source f, rawMultiDegree raw f, raw f, 0)))

-- f, with target ordered position-over-term: gb potMatrix f, syz potMatrix f, ...
potMatrix = method()
potMatrix Matrix := Matrix => f -> retarget(potFreeModule target f, f)

-- M, with ambient ordered position-over-term: presentation, trim, prune, ...
potModule = method()
potModule Module := Module => M -> M.cache.potModule ??= (
    F' := potFreeModule ambient M;
    subquotient(F',
	if M.?generators then retarget(F', M.generators),
	if M.?relations  then retarget(F', M.relations)))

-- presentation computed position-over-term, cached on M itself,
-- so later presentation M, prune M, etc. reuse it
potPresentation = method()
potPresentation Module := Matrix => M -> M.cache.presentation ??= presentation potModule M

M' = potModule M;
elapsedTime presentation M';                 -- ~0.3s
elapsedTime trim (M'**R^1);                  -- ~0.1s
elapsedTime presentation (M'**R^1);          -- ~0.2s
elapsedTime presentation trim (M'**R^1);     -- ~0.25s
elapsedTime gb potMatrix(gens M | relations M); -- ~0.06s, 103 elements
elapsedTime potPresentation M;               -- seeds M.cache.presentation
elapsedTime betti presentation prune M       -- ~0.01s: 18 gens in degree 3, 60 linear relations
-- checks: the relations are relations, and they are all of them
assert((gens M * presentation M) % gb relations M == 0)
assert(numerator hilbertSeries coker presentation M ==
    numerator hilbertSeries coker relations M
    - numerator hilbertSeries coker potMatrix(gens M | relations M))

-----------------------------------------------------------------------------
-- original (term-over-position) computations: each takes hours
presentation (M);
--why is presentation not caching? any why is it faster here than when this occurs in the Gr(1,5) FFRT loop in char 2?

elapsedTime trim (M**R^1);
elapsedTime presentation (M**R^1);
elapsedTime presentation trim (M**R^1);
